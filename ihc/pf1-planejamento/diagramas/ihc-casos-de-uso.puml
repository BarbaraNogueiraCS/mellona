@startuml ihc-casos-de-uso
skinparam monochrome true
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 13
skinparam packageStyle rectangle
left to right direction

actor "Apicultor" as AP
actor "Técnico de\nmanutenção" as TM
actor "Central do apiário\n<<sistema>>" as CA

rectangle "Aplicativo Mellona" {
  usecase "Entrar no aplicativo\n(RF-01)" as U01
  usecase "Consultar painel\ndos apiários (RF-02)" as U02
  usecase "Consultar condições\nda colmeia (RF-03)" as U03
  usecase "Consultar histórico\nde medições (RF-04)" as U04
  usecase "Consultar estado dos\nequipamentos (RF-05)" as U05
  usecase "Acompanhar alertas\n(RF-06)" as U06
  usecase "Ver por que a sirene\ntocou ou não (RF-07)" as U07
  usecase "Receber notificação\n(RF-08)" as U08
  usecase "Ligar ou desligar\na proteção (RF-09)" as U09
  usecase "Registrar visita\n(RF-10)" as U10
  usecase "Ativar modo visita\n(RF-11)" as U11
  usecase "Ativar modo visita\nno apiário (RF-12)" as U12
  usecase "Registrar revisão\nda colmeia (RF-13)" as U13
  usecase "Iniciar manutenção\na partir de alerta (RF-14)" as U14
}

AP --> U01
AP --> U02
AP --> U03
AP --> U04
AP --> U06
AP --> U08
AP --> U09
AP --> U10
AP --> U11
AP --> U12
AP --> U13
TM --> U01
TM --> U05
TM --> U06
TM --> U14

U09 --> CA
U11 --> CA
U12 --> CA

U11 ..> U10 : <<include>>
U12 ..> U11 : <<extend>>
U07 ..> U06 : <<extend>>
U14 ..> U06 : <<extend>>
@enduml
