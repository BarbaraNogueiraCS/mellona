<?xml version="1.0" encoding="UTF-8"?>
<!--
  I1 — Aplicação de gestão (ERS, RES-01):
  desktop JavaFX no padrão MVC, com cadastros persistidos em SQLite por ORMLite.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.ufg.inf.mellona</groupId>
        <artifactId>mellona-spd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mellona-gestao</artifactId>
    <name>Mellona — gestão (JavaFX + ORMLite + SQLite)</name>

    <properties>
        <javafx.version>21.0.4</javafx.version>
        <ormlite.version>6.1</ormlite.version>
        <sqlite.version>3.46.0.0</sqlite.version>
    </properties>

    <dependencies>
        <!-- ORM -->
        <dependency>
            <groupId>com.j256.ormlite</groupId>
            <artifactId>ormlite-jdbc</artifactId>
            <version>${ormlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <!-- o driver SQLite registra logs via SLF4J; a versão da API é fixada para combinar com o slf4j-simple -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>

        <!-- Interface desktop (MVC) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!-- mvn -pl mellona-gestao javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.ufg.inf.mellona.gestao.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
