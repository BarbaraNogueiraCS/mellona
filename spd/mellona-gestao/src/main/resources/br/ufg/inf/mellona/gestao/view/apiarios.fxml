<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- View da tela de apiários (MVC). O controlador é criado por App, que injeta os repositórios. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.ufg.inf.mellona.gestao.controller.ApiarioController"
            styleClass="tela">
    <top>
        <VBox spacing="4">
            <padding><Insets top="24" right="32" bottom="16" left="32"/></padding>
            <Label text="CADASTROS" styleClass="sobretitulo"/>
            <Label text="Apiários" styleClass="titulo"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabela" BorderPane.alignment="TOP_LEFT">
            <BorderPane.margin><Insets left="32" bottom="16"/></BorderPane.margin>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="nomeCol" text="Apiário" prefWidth="200"/>
                <TableColumn fx:id="colmeiasCol" text="Colmeias" prefWidth="90"/>
                <TableColumn fx:id="protecaoCol" text="Proteção" prefWidth="110"/>
                <TableColumn fx:id="fusoCol" text="Fuso horário" prefWidth="160"/>
            </columns>
            <placeholder>
                <Label text="Nenhum apiário cadastrado. Use &quot;Novo apiário&quot; para começar."/>
            </placeholder>
        </TableView>
    </center>

    <right>
        <VBox spacing="8" prefWidth="372" minWidth="372" styleClass="formulario">
            <padding><Insets top="0" right="32" bottom="16" left="24"/></padding>
            <Label text="Nome do apiário (obrigatório)" styleClass="rotulo"/>
            <TextField fx:id="nomeField" promptText="Ex.: Apiário Serra"/>
            <Label text="Referência do local" styleClass="rotulo"/>
            <TextField fx:id="localField" promptText="Visível só para quem tem acesso"/>
            <Label text="Fuso horário" styleClass="rotulo"/>
            <TextField fx:id="fusoField"/>
            <VBox spacing="8">
                <padding><Insets top="16"/></padding>
                <Button text="Salvar apiário" onAction="#salvar" styleClass="principal" defaultButton="true"
                        maxWidth="Infinity" minWidth="-Infinity"/>
                <HBox spacing="8">
                    <Button text="Novo apiário" onAction="#novo" styleClass="secundario" minWidth="-Infinity"/>
                    <Button text="Inativar apiário" onAction="#inativar" styleClass="secundario" minWidth="-Infinity"/>
                </HBox>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="mensagem" wrapText="true" styleClass="mensagem">
            <padding><Insets top="0" right="32" bottom="24" left="32"/></padding>
        </Label>
    </bottom>
</BorderPane>
