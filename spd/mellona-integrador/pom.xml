<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integrador entre a base relacional (gestão) e a base de documentos (monitoramento) — ERS, RES-03.
  Etapa 1: contrato da mensagem de sincronização e regras de propagação, com testes.
  Etapa 2: publicador e ouvinte Redis Pub/Sub (Lettuce), transformadores ORM ↔ ODM e fila de reprocessamento.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.ufg.inf.mellona</groupId>
        <artifactId>mellona-spd</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mellona-integrador</artifactId>
    <name>Mellona — integrador (Redis Pub/Sub)</name>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <!-- Etapa 2: cliente Redis usado pelo publicador e pelo ouvinte -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>6.7.1.RELEASE</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
